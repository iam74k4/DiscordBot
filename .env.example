# ============================================================
# Discord Bot 設定ファイル
# このファイルを .env にコピーして値を設定してください
# ============================================================
#
# ローカルテスト:
#   本番Botと別のBotアプリケーションを作成し、テスト用のトークン・
#   クライアントIDを使用してください。テスト用Botは開発専用サーバー
#   にのみ招待し、本番環境と干渉しないようにします。
#   DISCORD_GUILD_ID を設定するとコマンドが即時反映されます。
#
# ============================================================

# ------------------------------------------------------------
# 必須設定（これらは必ず設定してください）
# ------------------------------------------------------------

# Discord Botトークン（Discord Developer Portalから取得）
# ローカルテスト時はテスト用Botのトークンを使用
DISCORD_TOKEN=your_discord_bot_token

# DiscordアプリケーションのクライアントID
# ローカルテスト時はテスト用BotのクライアントIDを使用
DISCORD_CLIENT_ID=your_discord_client_id

# Steam Web APIキー（https://steamcommunity.com/dev/apikey から取得）
STEAM_API_KEY=your_steam_api_key

# Bot管理者のDiscord ID（カンマ区切りで複数指定可）
BOT_OWNER_IDS=your_discord_user_id

# ------------------------------------------------------------
# 基本設定（必要に応じて変更）
# ------------------------------------------------------------

# 環境モード: development（開発）/ production（本番）
NODE_ENV=production

# タイムゾーン（バックアップやログの時刻に使用）
TZ=Asia/Tokyo

# 開発用: コマンド即時反映用のサーバーID（本番では空のまま）
# DISCORD_GUILD_ID=

# ------------------------------------------------------------
# アラート通知（任意）
# ------------------------------------------------------------

# システムアラート用Discord Webhook URL
# サーバー設定 → 連携サービス → Webhook から作成
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ------------------------------------------------------------
# 詳細設定（通常は変更不要）
# ------------------------------------------------------------

# バックアップ保持日数（デフォルト: 7日）
# BACKUP_RETENTION_DAYS=7

# バックアップ実行時刻（cron形式、デフォルト: 毎日4時）
# BACKUP_CRON=0 4 * * *

# 音声録音の最大時間（秒、デフォルト: 300 = 5分）
# MAX_RECORDING_DURATION=300

# 音声バッファの保持時間（秒、デフォルト: 600 = 10分）
# AUDIO_BUFFER_DURATION=600

# 同時接続可能なボイスチャンネル数（デフォルト: 5）
# MAX_CONCURRENT_VC_CONNECTIONS=5

# メモリ警告閾値（MB、デフォルト: 100）
# MEMORY_WARNING_THRESHOLD_MB=100

# メモリ危険閾値（MB、デフォルト: 150）
# MEMORY_CRITICAL_THRESHOLD_MB=150

# 録音ファイル保持時間（時間、デフォルト: 24）
# RECORDING_RETENTION_HOURS=24
